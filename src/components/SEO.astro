---
interface Props {
	title: string;
	description: string;
	canonical: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
}

const {
	title,
	description,
	canonical,
	image,
	imageAlt = '',
	type = 'website',
	noindex = false,
	publishedTime,
	modifiedTime,
} = Astro.props;

const canonicalUrl = canonical.endsWith('/') ? canonical : `${canonical}/`;
const robots = noindex ? 'noindex, follow' : 'index, follow';
const imageUrl = image || new URL('/og-default.jpg', Astro.site).href;
const resolvedAlt = image ? imageAlt || title : 'Irenes';
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta name="robots" content={robots} />
<meta name="google-site-verification" content="zylEfgnIV3HHmLUbj-NRU-qvrODw9Kuuiv7XXXUh7k8" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="Irenes" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={resolvedAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={resolvedAlt} />
