---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { cardDate } from '../lib/dates';

interface Props {
	entry: CollectionEntry<'posts'>;
	categoryName: string;
	heading?: 'h2' | 'h3';
	eager?: boolean;
	variant?: 'card' | 'overlay' | 'row' | 'list';
	excerpt?: boolean;
	sizes?: string;
	widths?: number[];
}

const {
	entry,
	categoryName,
	heading = 'h3',
	eager = false,
	variant = 'card',
	excerpt = false,
	sizes = '(min-width: 64rem) 22vw, (min-width: 40rem) 46vw, 100vw',
	widths = [400, 704],
} = Astro.props;

const { title, description, heroImage, heroAlt, pubDate } = entry.data;
const href = `/${entry.id}/`;
const date = cardDate(pubDate);
const Heading = heading;
const overlayWidths = widths;
---

<article class:list={['h-full', variant]}>
	<a
		class:list={[
			'group flex h-full overflow-hidden bg-card',
			variant === 'row' && 'flex-row gap-3',
			variant === 'list' && 'flex-col border border-border md:flex-row',
			variant !== 'row' && variant !== 'list' && 'flex-col',
			variant === 'card' && 'border border-border shadow-sm transition hover:-translate-y-0.5 hover:shadow-md',
		]}
		href={href}
	>
		{
			heroImage && variant === 'overlay' && (
				<span class="relative block h-full">
					<Picture
						src={heroImage}
						alt={heroAlt}
						formats={['avif', 'webp']}
						widths={overlayWidths}
						sizes={sizes}
						quality="mid"
						width={heroImage.width}
						height={heroImage.height}
						loading={eager ? 'eager' : 'lazy'}
						fetchpriority={eager ? 'high' : undefined}
						class="h-full w-full object-cover"
						pictureAttributes={{ class: 'absolute inset-0 h-full w-full' }}
					/>
					<span class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
					<time class="absolute right-3 top-3 rounded-full bg-primary px-2.5 py-1 text-[10px] font-bold text-primary-foreground" datetime={date.datetime}>
						{date.label}
					</time>
					<span class="absolute inset-x-0 bottom-0 p-4 md:p-6">
						<span class="mb-2 inline-flex rounded-full bg-primary px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-primary-foreground">
							{categoryName}
						</span>
						<Heading class:list={['font-serif font-bold leading-snug text-white group-hover:text-primary', heading === 'h2' ? 'text-xl md:text-2xl' : 'text-base']}>
							{title}
						</Heading>
					</span>
				</span>
			)
		}
		{
			heroImage && variant === 'card' && (
				<span class="relative block overflow-hidden">
					<Picture
						src={heroImage}
						alt={heroAlt}
						formats={['avif', 'webp']}
						widths={widths}
						sizes={sizes}
						quality="mid"
						width={heroImage.width}
						height={heroImage.height}
						loading={eager ? 'eager' : 'lazy'}
						fetchpriority={eager ? 'high' : undefined}
						class="aspect-[3/2] h-auto w-full object-cover transition duration-500 group-hover:scale-105"
					/>
					<span class="absolute bottom-3 left-3 rounded bg-primary px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-primary-foreground">
						{categoryName}
					</span>
				</span>
			)
		}
		{
			heroImage && variant === 'row' && (
				<Picture
					src={heroImage}
					alt={heroAlt}
					formats={['avif', 'webp']}
					widths={[160, 320]}
					sizes="112px"
					quality="mid"
					width={heroImage.width}
					height={heroImage.height}
					loading={eager ? 'eager' : 'lazy'}
					class="h-20 w-28 shrink-0 object-cover"
				/>
			)
		}
		{
			variant === 'card' && (
				<span class="flex flex-1 flex-col p-4">
					{
						!heroImage && (
							<span class="mb-2 inline-flex w-fit bg-primary px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-primary-foreground">
								{categoryName}
							</span>
						)
					}
					<Heading class="font-serif text-lg font-bold leading-snug group-hover:text-primary">{title}</Heading>
					<time class="mt-2 text-xs text-muted-foreground" datetime={date.datetime}>
						{date.label}
					</time>
					{excerpt && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{description}</p>}
					<span class="mt-auto inline-flex h-9 w-fit items-center bg-primary px-4 text-xs font-semibold text-primary-foreground">Saiba Mais</span>
				</span>
			)
		}
		{
			variant === 'list' && (
				<>
					{
						heroImage && (
							<Picture
								src={heroImage}
								alt={heroAlt}
								formats={['avif', 'webp']}
								widths={[400, 720]}
								sizes="(min-width: 48rem) 28vw, 100vw"
								quality="mid"
								width={heroImage.width}
								height={heroImage.height}
								loading={eager ? 'eager' : 'lazy'}
								fetchpriority={eager ? 'high' : undefined}
								class="h-full w-full object-cover"
								pictureAttributes={{ class: 'block h-56 w-full shrink-0 self-stretch md:h-auto md:w-2/5' }}
							/>
						)
					}
					<span class="flex flex-1 flex-col p-5">
						<span class="text-[10px] font-bold uppercase tracking-wider text-primary">{categoryName}</span>
						<Heading class="mt-2 font-serif text-xl font-bold leading-snug group-hover:text-primary md:text-2xl">{title}</Heading>
						<time class="mt-2 text-xs text-muted-foreground" datetime={date.datetime}>
							{date.label}
						</time>
						<p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{description}</p>
						<span class="mt-4 inline-flex h-9 w-fit items-center bg-primary px-4 text-xs font-semibold text-primary-foreground">Saiba Mais</span>
					</span>
				</>
			)
		}
		{
			variant === 'row' && (
				<span class="flex min-w-0 flex-1 flex-col justify-center py-1">
					<span class="text-[10px] font-bold uppercase tracking-wider text-primary">{categoryName}</span>
					<Heading class="mt-1 font-serif text-sm font-bold leading-snug group-hover:text-primary">{title}</Heading>
					<time class="mt-1 text-xs text-muted-foreground" datetime={date.datetime}>
						{date.label}
					</time>
				</span>
			)
		}
	</a>
</article>
