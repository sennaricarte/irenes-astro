---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/prose.css';
import FontPreload from '../components/FontPreload.astro';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	canonical: string;
	image?: string;
	imageAlt?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	publishedTime?: string;
	modifiedTime?: string;
	indexable?: boolean;
}

const { indexable = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<FontPreload />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		<meta name="theme-color" content="#a24e7d" />
		<SEO {...seo} />
		<slot name="jsonld" />
	</head>
	<body data-pagefind-ignore={indexable ? undefined : 'all'}>
		<a class="skip" href="#conteudo">Pular para o conteúdo</a>
		<Header currentPath={Astro.url.pathname} />
		<main id="conteudo" data-pagefind-body={indexable ? true : undefined}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 60;
		transform: translateY(-150%);
		border-radius: var(--radius-card);
		background: var(--color-primary);
		color: var(--color-primary-foreground);
		padding: 0.5rem 0.75rem;
		font-weight: 700;
	}

	.skip:focus {
		transform: none;
	}
</style>
