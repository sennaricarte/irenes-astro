---
import { Picture, getImage, Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ListingSidebar from '../components/ListingSidebar.astro';
import logo from '../assets/logo.webp';
import { readingMinutes } from '../lib/reading';
import { postDate } from '../lib/dates';
import { sortPosts } from '../lib/sort-posts';

interface Props {
	entry: CollectionEntry<'posts'>;
	headings: MarkdownHeading[];
	canonical: string;
}

const { entry, headings, canonical } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, category, tags = [], heroImage, heroAlt, noindex = false } = entry.data;

const [categories, tagEntries, posts] = await Promise.all([
	getCollection('categorias'),
	getCollection('tags'),
	getCollection('posts'),
]);

const categoryEntry = categories.find((item) => item.id === category || item.data.slug === category);
const categoryName = categoryEntry?.data.name ?? category;
const categoryHref = `/categoria/${category}/`;
const familySlug = categoryEntry?.data.familia;
const familyEntry = familySlug
	? categories.find((item) => item.id === familySlug || item.data.slug === familySlug)
	: undefined;
const familyName = familyEntry?.data.name ?? familySlug;
const familyHref = familySlug ? `/categoria/${familySlug}/` : undefined;
const minutes = readingMinutes(entry.body ?? '');

const tagLinks = tags.map((slug) => {
	const found = tagEntries.find((item) => item.id === slug || item.data.slug === slug);
	return { slug, name: found?.data.name ?? slug, href: `/tag/${slug}/` };
});

const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const others = sortPosts(posts.filter((item) => item.id !== entry.id));
const related = [
	...others.filter((item) => item.data.category === category),
	...others.filter((item) => item.data.category !== category),
].slice(0, 3);
const categoryNames = Object.fromEntries(categories.map((item) => [item.id, item.data.name]));
const nameOf = (slug: string) => categoryNames[slug] ?? slug;
const shareUrl = encodeURIComponent(canonical);
const shareText = encodeURIComponent(title);

const og = heroImage
	? await getImage({ src: heroImage, width: 1200, height: 630, format: 'jpg', fit: 'cover', quality: 'mid' })
	: undefined;
const ogImage = og ? new URL(og.src, Astro.site).href : new URL('/og-default.jpg', Astro.site).href;

const publishedTime = pubDate.toISOString();
const modifiedTime = updatedDate?.toISOString();
const { label: dateLabel, datetime: dateTime } = postDate(pubDate);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'BlogPosting',
			headline: title,
			description,
			...(ogImage ? { image: ogImage } : {}),
			datePublished: publishedTime,
			...(modifiedTime ? { dateModified: modifiedTime } : {}),
			author: { '@type': 'Organization', name: 'Irenes' },
			publisher: { '@type': 'Organization', name: 'Irenes', url: Astro.site?.href },
			mainEntityOfPage: canonical,
		},
		{
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ name: 'Início', item: new URL('/', Astro.site).href },
				...(familyHref && familyName ? [{ name: familyName, item: new URL(familyHref, Astro.site).href }] : []),
				{ name: categoryName, item: new URL(categoryHref, Astro.site).href },
				{ name: title, item: canonical },
			].map((item, index) => ({ '@type': 'ListItem', position: index + 1, ...item })),
		},
	],
};
const json = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<BaseLayout
	title={seoTitle || title}
	description={description}
	canonical={canonical}
	noindex={noindex}
	image={ogImage}
	imageAlt={heroImage ? heroAlt : 'Irenes'}
	type="article"
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	indexable
>
	<script slot="jsonld" type="application/ld+json" set:html={json} />
	<div class="mx-auto w-full max-w-[var(--container-page)] px-4 py-8 md:px-8">
		<nav aria-label="Breadcrumb">
			<ol class="mb-6 flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
				<li>
					<a class="flex items-center gap-1 hover:text-foreground" href="/">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3 w-3" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"></path><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
						Início
					</a>
				</li>
				{
					familyHref && familyName && (
						<li class="flex items-center gap-1">
							<span aria-hidden="true">›</span>
							<a class="hover:text-foreground" href={familyHref}>{familyName}</a>
						</li>
					)
				}
				<li class="flex items-center gap-1">
					<span aria-hidden="true">›</span>
					<a class="hover:text-foreground" href={categoryHref}>{categoryName}</a>
				</li>
				<li class="flex min-w-0 items-center gap-1">
					<span aria-hidden="true">›</span>
					<span class="max-w-[200px] truncate font-medium text-foreground sm:max-w-none" aria-current="page">{title}</span>
				</li>
			</ol>
		</nav>
		<div class="grid items-start gap-8 lg:grid-cols-12">
			<article class="min-w-0 lg:col-span-8">
				<p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-primary">
					<a href={categoryHref}>{categoryName}</a>
				</p>
				<h1 class="font-serif text-3xl font-bold leading-[1.12] md:text-5xl">{title}</h1>
				<div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 border-y border-border py-3 text-sm text-muted-foreground">
					<a class="font-semibold text-foreground hover:text-primary" href="/sobre/">Irenes</a>
					<span class="flex items-center gap-1.5">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><path d="M8 2v4"></path><path d="M16 2v4"></path><rect width="18" height="18" x="3" y="4" rx="2"></rect><path d="M3 10h18"></path></svg>
						<time datetime={dateTime}>{dateLabel}</time>
					</span>
					<span class="flex items-center gap-1.5">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
						{minutes} min de leitura
					</span>
				</div>
				{
					heroImage && (
						<Picture
							src={heroImage}
							alt={heroAlt}
							formats={['avif', 'webp']}
							widths={[480, 800, 1200]}
							sizes="(min-width: 64rem) 66vw, 100vw"
							quality="mid"
							width={heroImage.width}
							height={heroImage.height}
							loading="eager"
							fetchpriority="high"
							class="mt-6 h-auto w-full object-cover"
						/>
					)
				}
				{
					toc.length > 0 && (
						<details class="toc mt-8 border border-border bg-card p-4" open>
							<summary class="cursor-pointer text-xs font-bold tracking-[0.2em]">NESTE ARTIGO</summary>
							<ol class="mt-4 space-y-2 text-sm">
								{toc.map((heading) => (
									<li class:list={[heading.depth === 3 && 'pl-4']}>
										<a class="text-foreground/80 hover:text-primary" href={`#${heading.slug}`}>
											{heading.text}
										</a>
									</li>
								))}
							</ol>
						</details>
					)
				}
				<div class="prose prose-wide mt-8 max-w-none">
					<slot />
				</div>
				<div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-y border-border py-4">
					{
						tagLinks.length > 0 && (
							<ul class="flex flex-wrap gap-2">
								{tagLinks.map((tag) => (
									<li>
										<a class="bg-secondary px-2 py-1 text-xs font-semibold text-secondary-foreground hover:text-primary" href={tag.href}>
											{tag.name}
										</a>
									</li>
								))}
							</ul>
						)
					}
					<ul class="ml-auto flex gap-2">
						<li>
							<a class="inline-flex h-9 w-9 items-center justify-center bg-primary text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no Facebook">
								<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
							</a>
						</li>
						<li>
							<a class="inline-flex h-9 w-9 items-center justify-center bg-primary text-primary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`} target="_blank" rel="noopener noreferrer" aria-label="Compartilhar no Twitter">
								<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg>
							</a>
						</li>
					</ul>
				</div>
				<div class="mt-8 flex gap-4 border border-border bg-card p-5">
					<Image src={logo} alt="Irenes" format="webp" quality="mid" width={64} height={64} class="h-16 w-16 shrink-0" />
					<div>
						<h2 class="font-serif text-xl font-bold">Irenes</h2>
						<p class="mt-2 text-sm leading-relaxed text-muted-foreground">O nome Irene significa Paz. Em irenes.com.br, celebramos a arte de viver bem e em harmonia, cuidando de você e do ambiente que te cerca.</p>
					</div>
				</div>
				{
					related.length > 0 && (
						<section class="mt-10" aria-labelledby="continue-lendo">
							<h2 id="continue-lendo" class="mb-4 border-b-2 border-primary pb-2 font-serif text-2xl font-bold">Continue lendo</h2>
							<ul class="grid grid-cols-1 items-stretch gap-4 sm:grid-cols-3">
								{related.map((item) => (
									<li class="h-full">
										<PostCard entry={item} categoryName={nameOf(item.data.category)} sizes="(min-width: 64rem) 22vw, 100vw" widths={[320, 480]} />
									</li>
								))}
							</ul>
						</section>
					)
				}
			</article>
			<ListingSidebar excludeId={entry.id} searchId="busca-artigo" />
		</div>
	</div>
</BaseLayout>
