---
import BaseLayout from '../layouts/BaseLayout.astro';

const canonical = new URL('/categorias/', Astro.site).href;
const json = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
		{ '@type': 'ListItem', position: 2, name: 'Categorias', item: canonical },
	],
}).replace(/</g, '\\u003c');

const sections = [
	{
		title: 'Banheiro',
		slug: 'banheiro',
		description: 'Seu spa particular. Inspirações para transformar a rotina de higiene em um momento sensorial de pausa e prazer.',
		guide: { href: '/pilar/banheiro/', label: '🏠 Guia do ambiente' },
		children: [],
	},
	{
		title: 'Beleza',
		slug: 'beleza',
		description: 'Dicas de skincare, maquiagem e bem-estar para você se sentir radiante.',
		children: [
			{ title: 'Bem-Estar', slug: 'bem-estar' },
			{ title: 'Cabelos', slug: 'cabelos' },
			{ title: 'Maquiagem', slug: 'maquiagem' },
			{ title: 'Skincare', slug: 'skincare' },
		],
	},
	{
		title: 'Casa',
		slug: 'casa',
		description: 'Métodos práticos para organizar e tornar sua casa um lugar funcional e harmonioso.',
		children: [
			{ title: 'Cômodos', slug: 'comodos' },
			{ title: 'Finanças do Lar', slug: 'financas-do-lar' },
			{ title: 'Organização Prática', slug: 'organizacao-pratica' },
			{ title: 'Plantas e Jardins', slug: 'plantas-jardins' },
			{ title: 'Rotinas e Limpeza', slug: 'rotinas-e-limpeza' },
			{ title: 'Tecnologia do Lar', slug: 'tecnologia-do-lar' },
		],
	},
	{
		title: 'Cozinha',
		slug: 'cozinha',
		description: 'Mais que um cômodo: o lugar do afeto. Organização, aromas e pequenos rituais que tornam o cozinhar um ato de cuidado.',
		guide: { href: '/pilar/cozinha/', label: '🏠 Guia do ambiente' },
		children: [],
	},
	{
		title: 'Decoração',
		slug: 'decoracao',
		description: 'Inspirações de decoração acessível para transformar seu espaço em um santuário de paz.',
		children: [
			{ title: 'Estilos de Decoração', slug: 'estilos-de-decoracao' },
			{ title: 'Faça Você Mesma (DIY)', slug: 'faca-voce-mesma-diy' },
		],
	},
	{
		title: 'Descompressão',
		slug: 'descompressao',
		description: 'O ritual de soltar o dia. Pequenas práticas para liberar a tensão, voltar para si e habitar o agora com leveza.',
		guide: { href: '/pilar/descompressao/', label: '✨ A arte deste ritual' },
		children: [],
	},
	{
		title: 'Dormir Bem',
		slug: 'dormir-bem',
		description: 'A arte do descanso profundo. Rituais, ambiente e gestos que preparam o corpo e a mente para uma noite verdadeiramente reparadora.',
		guide: { href: '/pilar/dormir-bem/', label: '✨ A arte deste ritual' },
		children: [],
	},
	{
		title: 'Lifestyle',
		slug: 'lifestyle',
		children: [{ title: 'Dicas', slug: 'dicas' }],
	},
	{
		title: 'Quarto',
		slug: 'quarto',
		description: 'O refúgio mais íntimo da casa. Aqui o corpo descansa e a mente desacelera. Descubra como transformar o seu em um santuário pessoal de paz.',
		guide: { href: '/pilar/quarto/', label: '🏠 Guia do ambiente' },
		children: [],
	},
	{
		title: 'Sala',
		slug: 'sala',
		description: 'O coração da casa, onde a vida acontece. Da decoração à atmosfera, ideias para criar um ambiente que abraça quem entra.',
		guide: { href: '/pilar/sala/', label: '🏠 Guia do ambiente' },
		children: [],
	},
	{
		title: 'Skincare de Noite',
		slug: 'skincare-de-noite',
		description: 'O gesto de cuidado mais consciente do dia. Passo a passo, ingredientes e camadas que transformam o skincare em um momento de presença.',
		guide: { href: '/pilar/skincare-de-noite/', label: '✨ A arte deste ritual' },
		children: [],
	},
];
---

<BaseLayout
	title="Nossas Categorias — Irenes"
	description="Explore todas as categorias do Irenes: Beleza, Casa e Decoração — e suas subcategorias."
	canonical={canonical}
	indexable
>
	<script slot="jsonld" type="application/ld+json" set:html={json} />
	<div class="mx-auto w-full max-w-[var(--container-page)] px-4 py-8 md:px-8">
		<nav class="mb-6" aria-label="Breadcrumb">
			<ol class="flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
				<li><a class="hover:text-foreground" href="/">Início</a></li>
				<li class="flex items-center gap-1">
					<span aria-hidden="true">›</span>
					<span class="font-medium text-foreground" aria-current="page">Categorias</span>
				</li>
			</ol>
		</nav>
		<header class="mb-12 max-w-[var(--container-article)]">
			<h1 class="font-serif text-3xl font-bold leading-[1.12] md:text-5xl">Nossas Categorias</h1>
			<p class="mt-4 text-lg text-muted-foreground">Explore nossos três pilares — Beleza, Casa e Decoração — e todas as suas subcategorias.</p>
		</header>
		{
			sections.map((section) => (
				<section class="mb-12 border-b border-border/60 pb-12" aria-labelledby={`cat-${section.slug}`}>
					<h2 id={`cat-${section.slug}`} class="font-serif text-2xl font-bold md:text-3xl">
						{section.title}
					</h2>
					{section.description && <p class="mt-3 max-w-[var(--container-prose)] text-muted-foreground">{section.description}</p>}
					<p class="mt-4">
						<a class="font-bold text-primary" href={`/categoria/${section.slug}/`}>
							Ver artigos
						</a>
					</p>
					{section.guide && (
						<p class="mt-2">
							<a class="font-bold text-primary" href={section.guide.href}>
								{section.guide.label}
							</a>
						</p>
					)}
					{section.children.length > 0 ? (
						<ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
							{section.children.map((child) => (
								<li>
									<h3 class="font-serif text-xl">
										<a class="hover:text-primary" href={`/categoria/${child.slug}/`}>
											{child.title}
										</a>
									</h3>
								</li>
							))}
						</ul>
					) : (
						<p class="mt-4 text-sm text-muted-foreground">Nenhuma subcategoria cadastrada.</p>
					)}
				</section>
			))
		}
	</div>
</BaseLayout>
