---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { sortPosts } from '../lib/sort-posts';

const posts = await getCollection('posts');
const categories = await getCollection('categorias');
const categoryNames = Object.fromEntries(categories.map((item) => [item.id, item.data.name]));
const recent = sortPosts(posts).slice(0, 6);
const canonical = new URL('/404/', Astro.site).href;
---

<BaseLayout
	title="Artigo não encontrado — Irenes"
	description="O artigo que você procura não existe ou foi removido."
	canonical={canonical}
	noindex
>
	<div class="mx-auto w-full max-w-[var(--container-page)] px-4 py-8 md:px-8">
		<h1 class="font-serif text-3xl font-bold md:text-5xl">Artigo não encontrado</h1>
		<p class="mt-4 text-muted-foreground">O artigo que você procura não existe ou foi removido.</p>
		<p class="mt-4">
			<a class="font-bold text-primary" href="/">← Voltar ao início</a>
		</p>
		<form class="mt-8 flex max-w-md items-center gap-2" action="/busca/" method="get" role="search">
			<label class="sr-only" for="busca-404">Buscar</label>
			<input id="busca-404" class="h-10 flex-1 rounded-full border border-border/50 bg-muted/60 px-4 text-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" type="search" name="q" placeholder="Buscar..." />
			<button class="h-10 rounded-full bg-primary px-4 text-sm font-bold text-primary-foreground" type="submit">Buscar</button>
		</form>
		<ul class="mt-10 grid grid-cols-1 items-stretch gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{
				recent.map((entry) => (
					<li class="h-full">
						<PostCard entry={entry} categoryName={categoryNames[entry.data.category] ?? entry.data.category} />
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
