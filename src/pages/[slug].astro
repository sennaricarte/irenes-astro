---
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts');
	const pages = await getCollection('paginas');
	const postIds = new Set(posts.map((entry) => entry.id));
	const conflicts = pages.filter((entry) => postIds.has(entry.id)).map((entry) => entry.id);
	if (conflicts.length) {
		throw new Error(`Slugs duplicados entre posts e paginas: ${conflicts.join(', ')}`);
	}

	return [
		...posts.map((entry) => ({
			params: { slug: entry.id },
			props: { entry, collection: 'posts' as const },
		})),
		...pages.map((entry) => ({
			params: { slug: entry.id },
			props: { entry, collection: 'paginas' as const },
		})),
	];
}

const { entry, collection } = Astro.props;
const { Content, headings } = await render(entry);
const canonical = new URL(`/${entry.id}/`, Astro.site).href;
---

{
	collection === 'posts' ? (
		<PostLayout entry={entry} headings={headings} canonical={canonical}>
			<Content />
		</PostLayout>
	) : (
		<PageLayout title={entry.data.title} description={entry.data.description} canonical={canonical}>
			<Content />
		</PageLayout>
	)
}
