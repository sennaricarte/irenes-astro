    "@fontsource/lato": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "turndown": "^7.2.4",
    "wawoff2": "^2.0.1"
