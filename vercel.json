{
	"trailingSlash": true,
	"redirects": [
		{
			"source": "/sitemap.xml",
			"destination": "/sitemap-index.xml",
			"permanent": true
		},
		{
			"source": "/",
			"has": [
				{
					"type": "query",
					"key": "categoria",
					"value": "(?<valor>.+)"
				}
			],
			"destination": "/categoria/:valor/",
			"permanent": true
		}
	],
	"headers": [
		{
			"source": "/_astro/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/pagefind/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600"
				}
			]
		},
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		}
	]
}
